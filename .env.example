# Auth0 Regular Web Application.
# Domain has no scheme, for example tenant.us.auth0.com.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# 32-byte hex secret. Generate with: openssl rand -hex 32
AUTH0_SECRET=

# Optional identifier of an Auth0 API that signs RS256 access tokens.
# Leave this blank to verify the ID token. https://<AUTH0_DOMAIN>/userinfo still returns an opaque access token.
# The SDK does not read this variable. SecureDesk passes it as authorizationParameters.audience.
AUTH0_AUDIENCE=

# Public origin of this app.
APP_BASE_URL=http://localhost:3000

# Optional cookie controls. httpOnly is always enabled by the Auth0 SDK.
# AUTH0_COOKIE_SAME_SITE=lax
# AUTH0_COOKIE_SECURE=true

# PostgreSQL connection string used by Drizzle.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/securedesk

# OpenAI key stays on the server. It is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional Open-Meteo request timeout in milliseconds.
OPEN_METEO_TIMEOUT_MS=8000

# Set to true only behind a trusted reverse proxy.
TRUST_PROXY=false
